################################################################################
# project:
project:
  name: MagicSquare
  description: "마방진(Magic Square) 생성 및 검증 프로젝트"
  version: "1.0.0"
  language: Python

################################################################################
# code_style:
code_style:
  python_version: "3.10+"
  style_guide: "PEP8 (엄격 준수)"
  type_hints: "모든 함수의 파라미터와 반환값에 필수"
  docstring: "Google 스타일, 모든 public 메서드에 필수"
  max_line_length: 88

################################################################################
# architecture:
architecture:
  pattern: "ECB (Entity-Control-Boundary)"
  description: "3 레이어 아키텍처 패턴"
  layers:
    boundary:
      description: "외부 입출력 담당 (UI, API, CLI)"
      examples:
        - "cli.py: 커맨드라인 인터페이스"
        - "input_validator.py: 사용자 입력 검증"
      dependencies:
        - "control"
    control:
      description: "비즈니스 로직 담당"
      examples:
        - "magic_square_generator.py: 마방진 생성 로직"
        - "validation_service.py: 검증 서비스"
      dependencies:
        - "entity"
    entity:
      description: "도메인 데이터 및 규칙 담당"
      examples:
        - "magic_square.py: 마방진 모델"
        - "validation_rules.py: 검증 규칙"
      dependencies: []
  dependency_direction: "boundary -> control -> entity (역방향 금지)"

################################################################################
# tdd_rules:
tdd_rules:
  red_phase:
    description: "테스트 먼저 작성하고 실패 확인"
    rules:
      - "기능 구현 전 테스트 코드 작성 필수"
      - "모든 테스트가 명확하게 실패함을 확인"
      - "테스트 케이스가 명확한 실패 메시지 포함"
    must_not:
      - "이 단계에서 구현 코드 작성"
      - "테스트 작성 생략"

  green_phase:
    description: "최소 코드로만 테스트 통과"
    rules:
      - "테스트 통과하는 가장 간단한 구현만 작성"
      - "모든 테스트 통과 확인"
    must_not:
      - "리팩터링 수행"
      - "추가 최적화"
      - "불필요한 코드 추가"

  refactor_phase:
    description: "기능 변경 없이 구조 개선"
    rules:
      - "테스트 커버리지 유지 또는 증가"
      - "모든 테스트 통과 유지"
      - "코드 중복 제거"
      - "가독성 개선"
    must_not:
      - "기능 변경"
      - "새로운 기능 추가"
      - "테스트 수정 (refactor 필요 시 먼저 진행)"

################################################################################
# testing:
testing:
  framework: "pytest"
  pattern: "AAA (Arrange-Act-Assert)"
  coverage_minimum: "80%"
  fixture_scope:
    function: "기본 스코프, 각 테스트마다 새로 생성"
    module: "모듈 내 모든 테스트에서 공유"
    session: "전체 테스트 세션에서 공유 (데이터베이스 등에 사용)"
  naming_convention:
    test_functions: "test_로 시작 (예: test_generate_magic_square)"
    test_classes: "Test로 시작 (예: TestMagicSquareGenerator)"
    test_files: "test_로 시작 (예: test_magic_square.py)"

################################################################################
# forbidden:
forbidden:
  - pattern: "print() 사용"
    reason: "로깅 전용 도구 사용으로 통일해야 하며, 출력 추적 어려움"
    alternative: "logging 모듈 또는 logger 인스턴스 사용"

  - pattern: "하드코딩된 상수"
    reason: "유지보수 어려움, 매직 넘버 제거 필요"
    alternative: "constants.py에 정의 후 import하여 사용"

  - pattern: "except 단독 사용 (except:)"
    reason: "모든 예외를 무시하면 버그 추적 및 디버깅 어려움"
    alternative: "except SpecificException as e: 형태로 명시적 예외 처리"

  - pattern: "타입힌트 없는 함수"
    reason: "코드 가독성 저하, IDE 지원 불가, 타입 검사 불가"
    alternative: "def func(param: Type) -> ReturnType: 형태로 작성"

  - pattern: "ECB 레이어 간 역방향 의존 (entity -> control, control -> boundary)"
    reason: "의존성 역전으로 아키텍처 붕괴, 순환 의존성 발생"
    alternative: "의존성 역전 원칙(DIP) 적용, 인터페이스/추상 클래스 사용"

################################################################################
# file_structure:
file_structure: |
  MagicSquare/
  ├── boundary/                      # 외부 입출력 담당 레이어
  │   ├── __init__.py
  │   ├── cli.py                     # 커맨드라인 인터페이스
  │   ├── ui.py                      # UI 관련 모듈
  │   └── input_validator.py         # 사용자 입력 검증
  │
  ├── control/                       # 비즈니스 로직 담당 레이어
  │   ├── __init__.py
  │   ├── magic_square_generator.py  # 마방진 생성 로직
  │   ├── validation_service.py      # 검증 서비스
  │   └── algorithm.py               # 알고리즘 구현 (홀수, 짝수 등)
  │
  ├── entity/                        # 도메인 데이터 담당 레이어
  │   ├── __init__.py
  │   ├── magic_square.py            # 마방진 모델 (클래스)
  │   ├── validation_rules.py        # 검증 규칙 정의
  │   └── constants.py               # 상수 정의 (매직 넘버 금지)
  │
  ├── tests/                         # 테스트 디렉토리
  │   ├── __init__.py
  │   ├── test_magic_square.py       # 마방진 모델 테스트
  │   ├── test_generator.py          # 생성 로직 테스트
  │   ├── test_validation.py         # 검증 로직 테스트
  │   └── fixtures/                  # 테스트 픽스처 및 Mock 데이터
  │
  ├── main.py                        # 프로젝트 진입점
  ├── requirements.txt               # 의존성 (pytest, black, mypy 등)
  ├── pytest.ini                     # pytest 설정 파일
  └── .cursorrules                   # Cursor AI 규칙 (이 파일)

################################################################################
# ai_behavior:
ai_behavior:
  before_coding:
    - "관련된 테스트 파일 확인 (존재하지 않으면 먼저 작성)"
    - "ECB 아키텍처의 어느 레이어에 코드가 들어갈지 명확히 파악"
    - "기존 코드의 의존성 관계 파악 (역방향 의존 금지)"
    - "함수의 입출력 타입 결정 및 docstring 계획"

  during_coding:
    - "모든 함수에 타입힌트 필수 작성 (파라미터와 반환값)"
    - "ECB 레이어 경계 위반 금지 (의존성 방향 준수)"
    - "Google 스타일 docstring 모든 public 메서드에 작성"
    - "PEP8 준수 (max_line_length: 88, Black 기준)"
    - "하드코딩 상수 금지, constants.py에 정의하여 사용"
    - "print() 대신 logging 모듈 사용"
    - "명시적 예외 처리 (except Exception 사용 금지)"

  after_coding:
    - "작성한 코드가 tdd_rules 준수하는지 확인"
    - "관련 테스트 모두 통과하는지 확인"
    - "타입체크 도구로 검증 (mypy 등)"
    - "PEP8 준수 확인 (black, flake8 등)"
    - "ECB 의존성 방향 재확인 (역방향 없음)"

  violations:
    - "타입힌트 없는 함수: 즉시 추가 요청"
    - "ECB 레이어 경계 위반: 경고 출력 후 수정 요청"
    - "tdd_rules 위반: 위반 내용 명시 후 수정"
    - "forbidden 규칙 위반: 이유와 대안 함께 제시"
